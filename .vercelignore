# Deploy with landing/ as the Vercel Root Directory. Limit accidental root uploads too.
*
!landing/
!landing/**
landing/node_modules/
landing/.next/
landing/out/
landing/dist/
landing/.git/
landing/.openai/
landing/.vercel/
**/*.dmg
**/*.exe
**/*.msi
**/*.msix
**/*.pkg
**/*.nupkg
**/*.snupkg
**/*.AppImage
**/*.deb
**/*.rpm
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/.env*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.DS_Store
**/*.log
