{
  "name": "smartnotch-ad",
  "version": "1.0.0",
  "description": "Existing SmartNotch ad with recorded footage replaced by generated mockups",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/media": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "@remotion/player": "4.0.544"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.544",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.1"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts --webpack-poll=1000",
